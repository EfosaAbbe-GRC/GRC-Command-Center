# ─── GRC Command Center — Environment Template ───────────────────────────────
# Copy this file to .env and fill in real values.
# .env is gitignored. This file (.env.example) is safe to commit.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your real values
#   docker compose up --build

# ── Required ──────────────────────────────────────────────────────────────────

# Google Gemini API key — get from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-here

# ── Optional (defaults shown) ─────────────────────────────────────────────────

# Auth enforcement — set to false only for local dev debugging
AUTH_ENABLED=true

# Seeded user credentials — change before any non-local deployment
ADMIN_USERNAME=admin
ADMIN_PASSWORD=grc-admin-2026

ANALYST_USERNAME=analyst
ANALYST_PASSWORD=grc-analyst-2026

VIEWER_USERNAME=viewer
VIEWER_PASSWORD=grc-viewer-2026

# Path to your GRC documents folder on the host machine
# Windows example: C:\Users\efosb\OneDrive\Desktop\GRC Inspector\GRC_Analyst
# Docker will mount this as read-only inside the container
DOCUMENTS_PATH=./GRC_Analyst
