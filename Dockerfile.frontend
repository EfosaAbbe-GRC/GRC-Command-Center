# ─── GRC Command Center — Frontend ──────────────────────────────────────────
# Stage 1: Build React app
FROM node:20-alpine AS builder

WORKDIR /app

# Install deps first (cached layer)
COPY package.json package-lock.json* ./
RUN npm ci --silent

# Copy source and build
COPY . .
RUN npm run build

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: Serve with nginx (final image is ~25MB vs ~1GB with node)
FROM nginx:alpine

LABEL maintainer="GRC Command Center"
LABEL description="React 19 frontend — Enterprise Command Authority UI"

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# SPA routing + backend proxy config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3006

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost:3006/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
