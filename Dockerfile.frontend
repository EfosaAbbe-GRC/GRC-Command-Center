# ─── GRC Command Center — Frontend ──────────────────────────────────────────
# Base images pinned by digest (their tags' digests on 2026-10-26); Dependabot proposes bumps.
# Stage 1: Build React app
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS builder

WORKDIR /app

# Install deps first (cached layer)
COPY package.json package-lock.json* ./
RUN npm ci --silent

# Copy source and build
COPY . .
RUN npm run build

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: Serve with nginx (final image is ~25MB vs ~1GB with node)
FROM nginx:alpine@sha256:a3554c0d0b48177b1413c26e01f695334428020d9df01243fbae3e11cfd17417

LABEL maintainer="GRC Command Center"
LABEL description="React 19 frontend — Enterprise Command Authority UI"

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# SPA routing + backend proxy config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3006

# 127.0.0.1, not localhost: busybox wget tries IPv6 ::1 first, and nginx listens on IPv4
# only, so this check failed on every probe until 2026-10-26.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:3006/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
