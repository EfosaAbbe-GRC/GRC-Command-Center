# ─── GRC Command Center — .dockerignore ─────────────────────────────────────
# Keeps build context small and prevents secrets from leaking into images.

# Secrets — never in image
# Unanchored: a bare `.env` matched the context root only, so backend/.env was
# baked into the image at /app/.env until 2026-10-25.
**/.env
**/*.env
secrets/

# Git
.git
.gitignore

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Virtual environments
venv/
.venv/
env/

# Node (frontend build uses npm ci inside container)
node_modules/

# Runtime data — mounted as volumes, not baked into image
**/*.db
**/*.db-*
backend/pytest_output.txt
backend/faiss_index/
GRC_Analyst/

# Test files — not needed in production image
backend/tests/

# Dev tooling
.pytest_cache/
*.log
