# Windows batch files must keep CRLF line endings: cmd.exe can misparse LF-only or mixed
# endings (blocks, labels). run_dashboard.bat had mixed endings until 2026-10-26.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts run inside Linux containers (docker/db-init/): CRLF would break them.
*.sh text eol=lf
# Baked into the image and hash-checked against the container (v10, v12): keep bytes stable on Windows.
backend/data/*.json text eol=lf
